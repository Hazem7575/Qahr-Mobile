<!--
    ScriptHazem CALM theme — the default look of every ScriptHazem tool (see tools\_Brand\Kit\KIT.md).
    Design language: shadcn/ui / reui.io translated to WPF — calm, flat, warm-dark; 1px hairline borders instead of shadows;
    radius 8 (cards) / 6 (buttons, inputs, badges); 4/8 px spacing grid; muted icons; ONE restrained gold accent used only for
    the primary button, the active nav/tab indicator, selection and focus rings.
    Drop-in replacement for the old dark Themes\Theme.xaml: every key of that file exists here with the same name and type.
    Keys marked NEW are documented in KIT.md. Needs Loc.cs (namespace ScriptHazem.Kit) in the same assembly.
    Performance: no Effects (no DropShadow/Blur), no endless animations, all XAML brushes frozen.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kit="clr-namespace:ScriptHazem.Kit">

    <!-- ===================== palette (warm neutral dark, like the ScriptHazem launcher) ===================== -->
    <Color x:Key="BgColor">#0F0E0D</Color>          <!-- app background -->
    <Color x:Key="PanelColor">#171615</Color>       <!-- card / surface -->
    <Color x:Key="Panel2Color">#1E1C1A</Color>      <!-- muted surface (wells, hover, segmented track) -->
    <Color x:Key="SidebarColor">#121110</Color>     <!-- NEW: side panels -->
    <Color x:Key="WellColor">#141312</Color>        <!-- inputs / image wells -->
    <Color x:Key="LineColor">#2A2724</Color>        <!-- 1px hairlines -->
    <Color x:Key="LineStrongColor">#3A3632</Color>  <!-- NEW: hovered borders -->
    <Color x:Key="TextColor">#EDEBE8</Color>
    <Color x:Key="SubtleColor">#A8A29E</Color>      <!-- secondary text (7.4:1 on card) -->
    <Color x:Key="FaintColor">#8A837D</Color>       <!-- muted labels (4.7:1 on card) -->
    <Color x:Key="GoldLightColor">#E6C27A</Color>
    <Color x:Key="GoldColor">#D4A94F</Color>        <!-- THE accent -->
    <Color x:Key="GoldDarkColor">#A88236</Color>
    <Color x:Key="GoldSoftColor">#231E16</Color>    <!-- NEW: selected tint -->
    <Color x:Key="GoldEdgeColor">#5A4828</Color>    <!-- NEW: selected edge -->
    <Color x:Key="AccentColor">#D4A94F</Color>
    <Color x:Key="EmberColor">#D2665A</Color>       <!-- destructive, muted -->
    <Color x:Key="PlayTextColor">#1A1407</Color>    <!-- text on the gold button (9:1) -->
    <Color x:Key="HoverColor">#1F1D1B</Color>       <!-- NEW -->
    <Color x:Key="PressColor">#272421</Color>       <!-- NEW -->
    <Color x:Key="ShadowColor">#000000</Color>      <!-- NEW -->

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="{StaticResource Panel2Color}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="WellBrush" Color="{StaticResource WellColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="HeadingBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}"/>
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}"/>
    <SolidColorBrush x:Key="GoldText" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="GoldAccentBrush" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="GoldSoftBrush" Color="{StaticResource GoldSoftColor}"/>
    <SolidColorBrush x:Key="GoldEdgeBrush" Color="{StaticResource GoldEdgeColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="EmberBrush" Color="{StaticResource EmberColor}"/>
    <SolidColorBrush x:Key="PlayTextBrush" Color="{StaticResource PlayTextColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="PressBrush" Color="{StaticResource PressColor}"/>
    <SolidColorBrush x:Key="IconBrush" Color="#8F8882"/>                <!-- NEW: muted icons -->
    <SolidColorBrush x:Key="ThinGold" Color="#40D4A94F"/>
    <SolidColorBrush x:Key="OrnamentGold" Color="#4DD4A94F"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#59D4A94F"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#B80A0908"/>
    <SolidColorBrush x:Key="OkBrush" Color="#5DBE84"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#D9A441"/>
    <SolidColorBrush x:Key="ErrBrush" Color="#E0776B"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#7AA7DB"/>
    <!-- NEW: soft status surfaces (banners, badges, changed fields) + their 1px edges -->
    <SolidColorBrush x:Key="ErrSoftBrush" Color="#2A1816"/>
    <SolidColorBrush x:Key="ErrEdgeBrush" Color="#6E3A33"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#261F12"/>
    <SolidColorBrush x:Key="WarnEdgeBrush" Color="#6A5224"/>
    <SolidColorBrush x:Key="OkSoftBrush" Color="#15231A"/>
    <SolidColorBrush x:Key="OkEdgeBrush" Color="#2E5E40"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#161E28"/>
    <SolidColorBrush x:Key="InfoEdgeBrush" Color="#334C6B"/>
    <!-- the corner between two scrollbars (and a few system parts) use SystemColors.ControlBrush = light grey by default -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>

    <!-- primary fill: flat gold (a 3% vertical shade keeps it from looking printed) -->
    <LinearGradientBrush x:Key="GoldBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D8AE55" Offset="0"/>
        <GradientStop Color="#CFA34A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldFrameBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E0BC6E" Offset="0"/>
        <GradientStop Color="#B8913F" Offset="1"/>
    </LinearGradientBrush>
    <!-- Latin wordmark only -->
    <LinearGradientBrush x:Key="TitleGold" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EBCB86" Offset="0"/>
        <GradientStop Color="#C99C42" Offset="1"/>
    </LinearGradientBrush>
    <!-- preview well: barely-there spotlight -->
    <RadialGradientBrush x:Key="PreviewGlow" Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#221F1C" Offset="0"/>
        <GradientStop Color="#171615" Offset="0.7"/>
        <GradientStop Color="#141312" Offset="1"/>
    </RadialGradientBrush>
    <!-- NEW: stage for additive/glowing content (effects): darker and neutral -->
    <RadialGradientBrush x:Key="StageDarkBrush" Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.8" RadiusY="0.8">
        <GradientStop Color="#1A1918" Offset="0"/>
        <GradientStop Color="#0C0B0A" Offset="1"/>
    </RadialGradientBrush>

    <!-- ===================== fonts (embedded, SIL OFL) =====================
         UiFont = Inter for Latin + Cairo for Arabic (WPF font fallback picks Cairo for Arabic letters).
         The leading "/" resolves from the application root, so the dictionary can live in any folder. -->
    <FontFamily x:Key="UiFont">/Fonts/#Inter, /Fonts/#Cairo</FontFamily>
    <FontFamily x:Key="TitleFont">/Fonts/#Inter, /Fonts/#Cairo</FontFamily>
    <FontFamily x:Key="ArabicFont">/Fonts/#Cairo</FontFamily>
    <FontFamily x:Key="LogoFont">/Fonts/#Cinzel</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- corner hook (kept for compatibility; Calm uses it at most once, very faint) -->
    <Geometry x:Key="CornerGeo">M0,30 L0,0 L30,0 M4,22 L4,4 L22,4 M8,8 L13,8 L13,13 L8,13 Z</Geometry>
    <ControlTemplate x:Key="Corners" TargetType="ContentControl">
        <Grid IsHitTestVisible="False" Opacity="0.8">
            <Path Data="{StaticResource CornerGeo}" Stroke="{StaticResource OrnamentGold}" StrokeThickness="1" Width="12" Height="12" Stretch="Uniform"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"/>
            <Path Data="{StaticResource CornerGeo}" Stroke="{StaticResource OrnamentGold}" StrokeThickness="1" Width="12" Height="12" Stretch="Uniform"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1"/></Path.RenderTransform>
            </Path>
        </Grid>
    </ControlTemplate>

    <!-- ===================== surfaces ===================== -->
    <!-- one subtle shadow, for popups and dialogs ONLY (layered borders, no Effect) -->
    <ControlTemplate x:Key="SoftShadow" TargetType="ContentControl">
        <Grid IsHitTestVisible="False">
            <Border Margin="-6,-3,-6,-10" CornerRadius="14" Background="#14000000"/>
            <Border Margin="-3,-1,-3,-6" CornerRadius="11" Background="#1F000000"/>
            <Border Margin="-1,0,-1,-3" CornerRadius="9" Background="#29000000"/>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="SoftShadowSmall" TargetType="ContentControl">
        <Grid IsHitTestVisible="False">
            <Border Margin="-1,0,-1,-3" CornerRadius="8" Background="#33000000"/>
        </Grid>
    </ControlTemplate>

    <!-- card: surface + hairline, radius 8 (name kept from the light kit; Calm has no card shadow) -->
    <Style x:Key="ElevatedCard" TargetType="ContentControl">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border CornerRadius="8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <!-- Card has NO outer margin (it would fight grids/StackPanels). In a stack of cards use SpacedCard (16 px below),
         or put the margin on the grid cell. NEW -->
    <Style x:Key="SpacedCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <!-- soft status banner: Border Style="{StaticResource WarnBanner}" (ErrBanner / OkBanner / InfoBanner too). NEW -->
    <Style x:Key="WarnBanner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarnSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource WarnEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,9"/>
    </Style>
    <Style x:Key="ErrBanner" TargetType="Border" BasedOn="{StaticResource WarnBanner}">
        <Setter Property="Background" Value="{StaticResource ErrSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ErrEdgeBrush}"/>
    </Style>
    <Style x:Key="OkBanner" TargetType="Border" BasedOn="{StaticResource WarnBanner}">
        <Setter Property="Background" Value="{StaticResource OkSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OkEdgeBrush}"/>
    </Style>
    <Style x:Key="InfoBanner" TargetType="Border" BasedOn="{StaticResource WarnBanner}">
        <Setter Property="Background" Value="{StaticResource InfoSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InfoEdgeBrush}"/>
    </Style>
    <!-- outline badge -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,1,8,2"/>
    </Style>
    <!-- accent badge (ids, active state) NEW -->
    <Style x:Key="GoldPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GoldSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GoldEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,1,8,2"/>
    </Style>
    <!-- keyboard key hint (Ctrl+F) NEW -->
    <Style x:Key="Kbd" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="5,0,5,1"/>
    </Style>

    <!-- ===================== text ===================== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource HeadingBrush}"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource HeadingBrush}"/>
    </Style>
    <!-- card title with the standard 12 px gap to the card body NEW -->
    <Style x:Key="CardHead" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <!-- small muted label above a group -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ===================== RTL helpers ===================== -->
    <Style x:Key="LtrText" TargetType="TextBlock">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="TextAlignment" Value="{Binding LtrAlign, Source={x:Static kit:Loc.I}}"/>
    </Style>
    <Style x:Key="LtrBox" TargetType="TextBox">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="TextAlignment" Value="{Binding LtrAlign, Source={x:Static kit:Loc.I}}"/>
    </Style>
    <Style TargetType="Image">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>

    <!-- ===================== scrollbars ===================== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="b" CornerRadius="3" Background="#34302C"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#4A4540"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#6B645D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="3,2">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2,3">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== buttons ===================== -->
    <!-- "outline" button (secondary) -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="{StaticResource BgBrush}"/>
        <Setter Property="Padding" Value="12,5,12,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="ring" CornerRadius="8" Margin="-3" BorderThickness="2" BorderBrush="{StaticResource FocusRingBrush}" Visibility="Collapsed"/>
                        <Border x:Name="b" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1"
                                BorderBrush="{StaticResource LineBrush}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource PressBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- primary: the ONE gold button of an area -->
    <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource PlayTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="ring" CornerRadius="8" Margin="-3" BorderThickness="2" BorderBrush="{StaticResource FocusRingBrush}" Visibility="Collapsed"/>
                        <Border x:Name="b" CornerRadius="6" Background="{StaticResource GoldBrush}"/>
                        <Border x:Name="tint" CornerRadius="6" Background="#FFFFFF" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tint" Property="Opacity" Value="0.1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="tint" Property="Background" Value="#000000"/>
                            <Setter TargetName="tint" Property="Opacity" Value="0.1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GoldButton}"/>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Padding" Value="9,2,9,3"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="SmallGold" TargetType="Button" BasedOn="{StaticResource GoldButton}">
        <Setter Property="Padding" Value="9,2,9,3"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource ErrBrush}"/>
    </Style>
    <!-- borderless "ghost" button (toolbar) NEW -->
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="ring" CornerRadius="8" Margin="-3" BorderThickness="2" BorderBrush="{StaticResource FocusRingBrush}" Visibility="Collapsed"/>
                        <Border x:Name="b" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource PressBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- language switch: Content = {kit:T lang.toggle} ("EN" in Arabic, "عربي" in English) NEW -->
    <Style x:Key="LangToggle" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Padding" Value="9,3,9,4"/>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#B8433A"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== sidebar navigation =====================
         Tag = icon glyph; content stretches (DockPanel with the count docked Right — mirrors itself in Arabic).
         Active = muted background + 2px gold bar on the reading-start edge. -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="8,1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Height="36">
                        <Border x:Name="bg" CornerRadius="6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"/>
                        <Border x:Name="bar" Width="2" Height="16" CornerRadius="1" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                Background="{StaticResource GoldAccentBrush}" Visibility="Hidden"/>
                        <Grid Margin="10,0,10,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="glyph" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       VerticalAlignment="Center" Foreground="{StaticResource IconBrush}"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource FocusRingBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource Panel2Brush}"/>
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource GoldText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== inputs ===================== -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource GoldAccentBrush}"/>
    </Style>

    <!-- search: Tag = placeholder -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource GoldAccentBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="ring" CornerRadius="8" Margin="-3" BorderThickness="2" BorderBrush="{StaticResource FocusRingBrush}" Visibility="Collapsed"/>
                        <Border x:Name="b" CornerRadius="6" Background="{StaticResource WellBrush}" BorderThickness="1"
                                BorderBrush="{StaticResource LineBrush}" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="glass" Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource IconBrush}"
                                           VerticalAlignment="Center" Margin="0,0,9,0" FontSize="12.5"/>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ph" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{StaticResource FaintBrush}"
                                           VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GoldEdgeBrush}"/>
                            <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- text field. Tag = placeholder (shown while empty). State: kit:FieldState.State="changed|error|ok" draws an overlay edge that
         hover/focus never hide (the old Tag="changed|error|ok" still works and then shows no placeholder).
         Padding is applied ONCE (by the text host); the outer border has no padding. -->
    <Style x:Key="FieldBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource GoldAccentBrush}"/>
        <Setter Property="Background" Value="{StaticResource WellBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="ring" CornerRadius="8" Margin="-3" BorderThickness="2" BorderBrush="{StaticResource FocusRingBrush}" Visibility="Collapsed"/>
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <Grid>
                                <!-- the text host applies Padding itself; the placeholder is inset the same way (+2 = caret gap) -->
                                <Border Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
                                    <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource FaintBrush}" FontFamily="{StaticResource UiFont}"
                                               Margin="2,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Visibility="Collapsed"
                                               TextTrimming="CharacterEllipsis" TextAlignment="{TemplateBinding TextAlignment}"/>
                                </Border>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <!-- state overlay: drawn above the hover/focus border -->
                        <Border x:Name="state" CornerRadius="6" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GoldEdgeBrush}"/>
                            <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource PanelBrush}"/>
                        </Trigger>
                        <!-- states (attached property, preferred) -->
                        <Trigger Property="kit:FieldState.State" Value="changed">
                            <Setter TargetName="state" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="state" Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                            <Setter TargetName="b" Property="Background" Value="{StaticResource WarnSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="kit:FieldState.State" Value="error">
                            <Setter TargetName="state" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="state" Property="BorderBrush" Value="{StaticResource ErrBrush}"/>
                            <Setter TargetName="b" Property="Background" Value="{StaticResource ErrSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="kit:FieldState.State" Value="ok">
                            <Setter TargetName="state" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="state" Property="BorderBrush" Value="{StaticResource OkBrush}"/>
                        </Trigger>
                        <!-- states via Tag (back-compat with tools written before the attached property) -->
                        <Trigger Property="Tag" Value="changed">
                            <Setter TargetName="state" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="state" Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                            <Setter TargetName="b" Property="Background" Value="{StaticResource WarnSoftBrush}"/>
                            <Setter TargetName="ph" Property="Text" Value=""/>
                        </Trigger>
                        <Trigger Property="Tag" Value="error">
                            <Setter TargetName="state" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="state" Property="BorderBrush" Value="{StaticResource ErrBrush}"/>
                            <Setter TargetName="ph" Property="Text" Value=""/>
                        </Trigger>
                        <Trigger Property="Tag" Value="ok">
                            <Setter TargetName="state" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="state" Property="BorderBrush" Value="{StaticResource OkBrush}"/>
                            <Setter TargetName="ph" Property="Text" Value=""/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource FieldBox}"/>
    <Style x:Key="MonoArea" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <!-- ===================== check box ===================== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Width="16" Height="16" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource LineStrongBrush}"
                                Background="{StaticResource WellBrush}" VerticalAlignment="Center">
                            <Path x:Name="mark" Data="M3,8 L6.5,11.2 L13,4.8" Stroke="{StaticResource PlayTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" FlowDirection="LeftToRight"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="#55504A"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource GoldAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource GoldAccentBrush}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource GoldAccentBrush}"/>
                            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GoldCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"/>

    <!-- ===================== combo box ===================== -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" CornerRadius="6" Background="{StaticResource WellBrush}" BorderThickness="1" BorderBrush="{StaticResource LineBrush}">
                        <TextBlock x:Name="arrow" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{StaticResource IconBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GoldEdgeBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent" Margin="4,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Panel2Brush}"/>
                            <Setter Property="Foreground" Value="{StaticResource GoldText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,4,28,5"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Style="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="{TemplateBinding Padding}" Background="Transparent"
                                 BorderThickness="0" VerticalAlignment="Center" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade" VerticalOffset="4">
                            <Grid Margin="6,0,6,10" MinWidth="{TemplateBinding ActualWidth}">
                                <ContentControl Template="{StaticResource SoftShadow}" Focusable="False"/>
                                <Border CornerRadius="8" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        Padding="0,4" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== tabs: shadcn segmented "TabsList" ===================== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" HorizontalAlignment="Left" CornerRadius="8" Background="{StaticResource Panel2Brush}" Padding="3">
                            <TabPanel IsItemsHost="True"/>
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="b" CornerRadius="6" Padding="12,4,12,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BgBrush}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== chips (filter badges) ===================== -->
    <Style x:Key="ChipItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" CornerRadius="6" Padding="10,3,10,4" BorderThickness="1" BorderBrush="{StaticResource LineBrush}"
                            Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource GoldSoftBrush}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GoldEdgeBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource GoldText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ChipToggle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="6" Padding="10,3,10,4" BorderThickness="1" BorderBrush="{StaticResource LineBrush}"
                            Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource GoldSoftBrush}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GoldEdgeBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource GoldText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- on/off filter chip (ToggleButton) with the chip look NEW -->
    <Style x:Key="ChipCheck" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" CornerRadius="6" Padding="10,3,10,4" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource GoldSoftBrush}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource GoldEdgeBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource GoldText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
