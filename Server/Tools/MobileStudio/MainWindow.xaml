<Window x:Class="MobileStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kit="clr-namespace:ScriptHazem.Kit"
        Title="{kit:T app.title}" Width="1360" Height="860" MinWidth="1100" MinHeight="680"
        Icon="pack://application:,,,/Images/scripthazem.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{StaticResource BgBrush}" FlowDirection="{Binding Flow, Source={x:Static kit:Loc.I}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== header ===== -->
        <Border Grid.ColumnSpan="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                            WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" MouseLeftButtonUp="Logo_Click" Background="Transparent"
                            ToolTip="{kit:T about.tip}">
                    <Image Source="pack://application:,,,/Images/scripthazem.ico" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="QAHRMOBILE STUDIO" FontFamily="{StaticResource LogoFont}" FontSize="14.5" FontWeight="Bold" Margin="11,0,0,0"
                               Foreground="{StaticResource TitleGold}" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                    <Border Width="1" Height="16" Background="{StaticResource LineBrush}" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center">
                        <Run Text="{kit:T header.by}"/><Run Text="{kit:T header.brand}" Foreground="{StaticResource SubtleBrush}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0" MouseLeftButtonUp="Pill_Click" ToolTip="{kit:T pill.tip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="GameDot" Width="7" Height="7" Fill="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock x:Name="GamePill" Text="GameServer" FontSize="12" Foreground="{StaticResource SubtleBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0" MouseLeftButtonUp="Pill_Click" ToolTip="{kit:T pill.tip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="AccDot" Width="7" Height="7" Fill="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock x:Name="AccPill" Text="AccServer" FontSize="12" Foreground="{StaticResource SubtleBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,12,0" MouseLeftButtonUp="Players_Click" ToolTip="{kit:T pill.playersTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource IconBrush}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock x:Name="OnlinePill" Text="—" FontSize="12" Foreground="{StaticResource SubtleBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Width="1" Height="20" Background="{StaticResource LineBrush}" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource LangToggle}" Content="{kit:T lang.toggle}" ToolTip="{kit:T lang.tip}" Click="Lang_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click"/>
                    <Button Style="{StaticResource CaptionButton}" x:Name="MaxButton" Content="&#xE922;" Click="Max_Click"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== side navigation ===== -->
        <Border Grid.Row="1" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,16,0,0">
                    <TextBlock Text="{kit:T nav.grp.server}" Style="{StaticResource SectionTitle}" Margin="20,0,20,8"/>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE80F;" CommandParameter="Dashboard" Checked="Nav_Checked" Content="{kit:T nav.dashboard}"/>
                    <RadioButton x:Name="NavServers" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE7F4;" CommandParameter="Servers" Checked="Nav_Checked" Content="{kit:T nav.servers}"/>
                    <RadioButton x:Name="NavBuild" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xEC7A;" CommandParameter="Build" Checked="Nav_Checked" Content="{kit:T nav.build}"/>
                    <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE74C;" CommandParameter="Tools" Checked="Nav_Checked" Content="{kit:T nav.tools}"/>
                    <TextBlock Text="{kit:T nav.grp.updates}" Style="{StaticResource SectionTitle}" Margin="20,18,20,8"/>
                    <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE7B8;" CommandParameter="Updates" Checked="Nav_Checked" Content="{kit:T nav.updates}"/>
                    <RadioButton x:Name="NavMirror" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE753;" CommandParameter="Mirror" Checked="Nav_Checked" Content="{kit:T nav.mirror}"/>
                    <TextBlock Text="{kit:T nav.grp.live}" Style="{StaticResource SectionTitle}" Margin="20,18,20,8"/>
                    <RadioButton x:Name="NavPlayers" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE716;" CommandParameter="Players" Checked="Nav_Checked" Content="{kit:T nav.players}"/>
                    <RadioButton x:Name="NavLogs" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE756;" CommandParameter="Logs" Checked="Nav_Checked" Content="{kit:T nav.logs}"/>
                    <TextBlock Text="{kit:T nav.grp.guard}" Style="{StaticResource SectionTitle}" Margin="20,18,20,8"/>
                    <RadioButton x:Name="NavBackup" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE81C;" CommandParameter="Backup" Checked="Nav_Checked" Content="{kit:T nav.backup}"/>
                    <RadioButton x:Name="NavGit" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE943;" CommandParameter="Git" Checked="Nav_Checked" Content="{kit:T nav.git}"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE713;" CommandParameter="Settings" Checked="Nav_Checked" Content="{kit:T nav.settings}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,18,16" VerticalAlignment="Bottom">
                    <TextBlock x:Name="SideStatus" FontSize="11.5" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" LineHeight="18"/>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12,0,10"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" LineHeight="17">
                        <Run Text="© 2026"/> <Run Text="{kit:T header.brand}" Foreground="{StaticResource SubtleBrush}"/>
                        <LineBreak/><Run Text="{kit:T rights}"/>
                    </TextBlock>
                </StackPanel>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- ===== page host ===== -->
        <ContentControl x:Name="PageHost" Grid.Row="1" Grid.Column="1" Focusable="False"/>

        <!-- ===== toast ===== -->
        <Border x:Name="Toast" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                CornerRadius="8" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                Padding="14,7,16,8" Opacity="0" IsHitTestVisible="False" Cursor="Hand" MouseLeftButtonUp="Toast_Click" ToolTip="{kit:T copy.toastTip}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="16"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastGlyph" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource GoldText}" VerticalAlignment="Center" Margin="0,1,9,0" FontSize="12"/>
                <TextBlock x:Name="ToastText" FontSize="12.5" MaxWidth="760" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ===== About ===== -->
        <Grid x:Name="AboutOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{StaticResource ScrimBrush}" Visibility="Collapsed"
              MouseLeftButtonUp="About_Close">
            <Grid Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" MouseLeftButtonUp="About_CardClick">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="AboutScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <ContentControl Template="{StaticResource SoftShadow}" Focusable="False"/>
                <Border CornerRadius="10" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
                <StackPanel Margin="28,28,28,24">
                    <Border Width="64" Height="64" CornerRadius="10" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Images/scripthazem.ico" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="QAHRMOBILE STUDIO" FontFamily="{StaticResource LogoFont}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TitleGold}"
                               HorizontalAlignment="Center" Margin="0,16,0,0" FlowDirection="LeftToRight"/>
                    <TextBlock x:Name="AboutVersion" FontSize="12" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <TextBlock Text="{kit:T about.what}" FontSize="12.5" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18"/>
                    <TextBlock HorizontalAlignment="Center" FontSize="13.5">
                        <Run Text="{kit:T about.dev}" Foreground="{StaticResource SubtleBrush}"/><Run Text="{kit:T header.brand}" Foreground="{StaticResource GoldText}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Text="{kit:T about.copyright}" HorizontalAlignment="Center" FontSize="11.5" Foreground="{StaticResource FaintBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="{kit:T about.fonts}" HorizontalAlignment="Center" FontSize="11.5" Foreground="{StaticResource FaintBrush}" Margin="0,5,0,0"/>
                    <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="10,4" Click="Phone_Click" ToolTip="{kit:T about.phoneTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE717;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource GoldText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="01032044960" FlowDirection="LeftToRight" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Style="{StaticResource GoldButton}" Padding="18,6" Margin="0,0,8,0" Click="Contact_Click" ToolTip="facebook.com/ScriptHazem">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{kit:T about.contact}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Content="{kit:T about.close}" Padding="22,5,22,6" Click="About_Close"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
