<Application x:Class="MobileStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="clr-namespace:ScriptHazem.Kit"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.Calm.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== MobileStudio-only helpers (built on the Calm kit keys, no hard-coded colours) ===== -->

            <!-- small icon glyph inside a ghost button (muted) -->
            <Style x:Key="BtnGlyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="Foreground" Value="{StaticResource IconBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Margin" Value="0,1,8,0"/>
            </Style>
            <!-- glyph inside the gold button (inherits the dark text colour) -->
            <Style x:Key="GoldGlyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,1,7,0"/>
            </Style>
            <!-- card icon tile -->
            <Style x:Key="IconTile" TargetType="Border">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="TileGlyph" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="{StaticResource IconBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- stat label / value -->
            <Style x:Key="StatK" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Margin" Value="0,0,0,3"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="StatV" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource HeadingBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <!-- page sub title -->
            <Style x:Key="PageSub" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <!-- status pill in the header -->
            <Style x:Key="StatusPill" TargetType="Border" BasedOn="{StaticResource Pill}">
                <Setter Property="Padding" Value="9,3,10,4"/>
                <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- FieldBox that always reads left-to-right (IP, port, paths) -->
            <Style x:Key="LtrField" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
                <Setter Property="FlowDirection" Value="LeftToRight"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
