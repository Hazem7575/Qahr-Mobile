<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>MobileStudio</AssemblyName>
    <RootNamespace>MobileStudio</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>Images\scripthazem.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CA1416;CS8632</NoWarn>

    <!-- ScriptHazem ownership -->
    <Company>ScriptHazem</Company>
    <Authors>ScriptHazem</Authors>
    <Product>QahrMobile Studio by ScriptHazem</Product>
    <Title>QahrMobile Studio</Title>
    <Description>Qahr Mobile server control center — ScriptHazem (سكربتات حازم)</Description>
    <Copyright>© 2026 ScriptHazem · سكربتات حازم — All rights reserved.</Copyright>
    <Version>1.0.0</Version>

    <!-- light idle footprint -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>

    <!-- one exe: dotnet publish -c Release (output publish\MobileStudio.exe, no .NET install needed) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Images\scripthazem.ico" />
    <None Include="Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Strings\Strings.*.json" LogicalName="Strings.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <!-- shared with the update console (one source of truth for patch rules, stats and the official manifest) -->
  <ItemGroup>
    <Compile Include="..\PatchConsole\PatchCore.cs" Link="Shared\PatchCore.cs" />
    <Compile Include="..\PatchConsole\Stats.cs" Link="Shared\Stats.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="publish\**;out\**" />
    <None Remove="publish\**;out\**" />
    <Page Remove="publish\**;out\**" />
  </ItemGroup>

</Project>
