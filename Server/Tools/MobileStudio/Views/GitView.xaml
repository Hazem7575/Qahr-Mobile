<UserControl x:Class="MobileStudio.Views.GitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="clr-namespace:ScriptHazem.Kit"
             xmlns:core="clr-namespace:MobileStudio.Core">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource GhostButton}" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T common.refresh}"/></StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{kit:T git.title}" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="SubText" Style="{StaticResource PageSub}"/>
            </StackPanel>
        </DockPanel>

        <!-- the 3 steps -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Border DockPanel.Dock="Left" Style="{StaticResource Kbd}" Margin="0,1,10,0" VerticalAlignment="Top"><TextBlock Text="1" FontSize="11"/></Border>
                        <StackPanel>
                            <TextBlock Text="{kit:T git.s1}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{kit:T git.s1Hint}" Style="{StaticResource Hint}" Margin="0,2,0,10"/>
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel VerticalAlignment="Bottom">
                        <Button x:Name="PreviewBtn" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Preview_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B3;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T git.preview}"/></StackPanel>
                        </Button>
                        <Button x:Name="SyncBtn" Style="{StaticResource GhostButton}" Click="Sync_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T git.sync}"/></StackPanel>
                        </Button>
                    </WrapPanel>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Border DockPanel.Dock="Left" Style="{StaticResource Kbd}" Margin="0,1,10,0" VerticalAlignment="Top"><TextBlock Text="2" FontSize="11"/></Border>
                        <StackPanel>
                            <TextBlock Text="{kit:T git.s2}" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="ScanHint" Text="{kit:T git.s2Hint}" Style="{StaticResource Hint}" Margin="0,2,0,10"/>
                        </StackPanel>
                    </DockPanel>
                    <Button x:Name="ScanBtn" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="Scan_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA18;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T git.scan}"/></StackPanel>
                    </Button>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Border DockPanel.Dock="Left" Style="{StaticResource Kbd}" Margin="0,1,10,0" VerticalAlignment="Top"><TextBlock Text="3" FontSize="11"/></Border>
                        <TextBlock Text="{kit:T git.s3}" Style="{StaticResource CardTitle}"/>
                    </DockPanel>
                    <TextBox x:Name="MsgBox" DockPanel.Dock="Top" Style="{StaticResource LtrField}" Margin="0,10,0,8" Tag="Mobile: ..." TextChanged="Msg_Changed"/>
                    <DockPanel>
                        <CheckBox x:Name="PushBox" DockPanel.Dock="Left" Content="{kit:T git.alsoPush}" IsChecked="True" VerticalAlignment="Center"/>
                        <Button x:Name="CommitBtn" Style="{StaticResource GoldButton}" HorizontalAlignment="Right" Click="Commit_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" Style="{StaticResource GoldGlyph}"/><TextBlock Text="{kit:T git.commit}"/></StackPanel>
                        </Button>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="ChangesTitle" Text="{kit:T git.changes}" Style="{StaticResource SectionTitle}" Margin="2,0,0,8"/>
                <Grid>
                    <ListView x:Name="ChangeList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="90"><GridViewColumn.Header><TextBlock Text="{kit:T git.col.state}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate>
                                        <TextBlock x:Name="t" Text="{Binding StatusText}" FontWeight="Medium" Foreground="{StaticResource WarnBrush}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="new"><Setter TargetName="t" Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="del"><Setter TargetName="t" Property="Foreground" Value="{StaticResource ErrBrush}"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="560"><GridViewColumn.Header><TextBlock Text="{kit:T git.col.path}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Path}" Style="{StaticResource LtrText}" FontFamily="{StaticResource MonoFont}" FontSize="12"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel x:Name="Clean" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border Style="{StaticResource IconTile}" Width="48" Height="48" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource TileGlyph}" Foreground="{StaticResource OkBrush}"/>
                        </Border>
                        <TextBlock Text="{kit:T git.clean}" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="{kit:T git.cleanHint}" Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="ScanBanner" Style="{StaticResource InfoBanner}" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock x:Name="ScanGlyph" Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource InfoBrush}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock x:Name="ScanText" Text="{kit:T git.notScanned}" FontSize="12.5" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="HitList" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RuleText}" FontSize="11.5" Foreground="{StaticResource ErrBrush}" Margin="10,0,0,0"/>
                                            <TextBlock Text="{Binding Where}" Style="{StaticResource LtrText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DockPanel Grid.Row="1"><DockPanel DockPanel.Dock="Top" Margin="2,0,0,6"><core:CopyAllButton Target="{Binding ElementName=OutputBox}" DockPanel.Dock="Right"/><TextBlock Style="{StaticResource SectionTitle}" Text="{kit:T build.output}" VerticalAlignment="Center"/></DockPanel>
                <TextBox x:Name="OutputBox" Style="{StaticResource MonoArea}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/></DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
