<UserControl x:Class="MobileStudio.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="clr-namespace:ScriptHazem.Kit">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource GhostButton}" Click="Refresh_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T common.refresh}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="OpenConsole_Click" ToolTip="{kit:T upd.openConsoleTip}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T upd.openConsole}"/></StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{kit:T upd.title}" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="SubText" Style="{StaticResource PageSub}"/>
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="Tabs" Grid.Row="1">
            <!-- ======================= new update ======================= -->
            <TabItem Header="{kit:T upd.tab.new}" x:Name="TabNew">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12" AllowDrop="True" Drop="Drop_Drop" DragOver="Drop_DragOver">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="PickFolder_Click" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T upd.pickFolder}"/></StackPanel>
                                </Button>
                                <Border Style="{StaticResource IconTile}" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE898;" Style="{StaticResource TileGlyph}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{kit:T upd.dropTitle}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="SourceText" Text="{kit:T upd.dropHint}" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Top" x:Name="StageTitle" Style="{StaticResource SectionTitle}" Text="{kit:T upd.files}" Margin="2,0,0,8"/>
                        <ListView x:Name="StageList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="40">
                                        <GridViewColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Include, Mode=TwoWay}" Checked="Include_Changed" Unchecked="Include_Changed"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="360">
                                        <GridViewColumn.Header><TextBlock Text="{kit:T upd.col.target}"/></GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource LtrField}" Padding="6,2" MinWidth="330" FontFamily="{StaticResource MonoFont}" FontSize="12" LostFocus="Target_LostFocus"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="120">
                                        <GridViewColumn.Header><TextBlock Text="{kit:T upd.col.status}"/></GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="st" Text="{Binding StatusText}" FontWeight="Medium" Foreground="{StaticResource SubtleBrush}"/>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding StatusKey}" Value="New"><Setter TargetName="st" Property="Foreground" Value="{StaticResource InfoBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKey}" Value="Changed"><Setter TargetName="st" Property="Foreground" Value="{StaticResource OkBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKey}" Value="Bad"><Setter TargetName="st" Property="Foreground" Value="{StaticResource ErrBrush}"/></DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="90">
                                        <GridViewColumn.Header><TextBlock Text="{kit:T upd.col.size}"/></GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="300">
                                        <GridViewColumn.Header><TextBlock Text="{kit:T upd.col.reason}"/></GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Reason}" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource SpacedCard}">
                                <StackPanel>
                                    <TextBlock Text="{kit:T upd.notesTitle}" Style="{StaticResource CardHead}"/>
                                    <TextBlock Text="{kit:T upd.version}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="VersionBox" Style="{StaticResource LtrField}"/>
                                    <TextBlock x:Name="VersionHint" Style="{StaticResource Hint}" Margin="0,4,0,12"/>
                                    <TextBlock Text="{kit:T upd.titleField}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TitleBox" Style="{StaticResource FieldBox}" Tag="{kit:T upd.titlePh}"/>
                                    <TextBlock Text="{kit:T upd.notes}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                                    <TextBox x:Name="NotesBox" Style="{StaticResource FieldBox}" Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="{kit:T upd.notesHint}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{kit:T upd.reviewTitle}" Style="{StaticResource CardHead}"/>
                                    <TextBlock x:Name="ReviewText" FontSize="12.5" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" LineHeight="20"/>
                                    <ProgressBar x:Name="PubProgress" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="1" Visibility="Collapsed"/>
                                    <Button x:Name="PublishBtn" Style="{StaticResource GoldButton}" Margin="0,14,0,0" HorizontalAlignment="Left" Click="Publish_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" Style="{StaticResource GoldGlyph}"/><TextBlock Text="{kit:T upd.publish}"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ======================= history ======================= -->
            <TabItem Header="{kit:T upd.tab.history}" x:Name="TabHistory">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button x:Name="RollbackBtn" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Rollback_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T upd.rollback}"/></StackPanel>
                            </Button>
                            <Button x:Name="RemoveBtn" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Remove_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource BtnGlyph}" Foreground="{StaticResource ErrBrush}"/><TextBlock Text="{kit:T upd.remove}"/></StackPanel>
                            </Button>
                            <Button x:Name="TestBtn" Style="{StaticResource GhostButton}" Click="Test_Click" ToolTip="{kit:T upd.testTip}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EA;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T upd.test}"/></StackPanel>
                            </Button>
                        </WrapPanel>
                        <ListView x:Name="HistoryList" SelectionChanged="History_Selected">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="70">
                                        <GridViewColumn.Header><TextBlock Text="{kit:T upd.col.version}"/></GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Version}" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="80">
                                        <GridViewColumn.Header><TextBlock Text="{kit:T upd.col.kind}"/></GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="b" Style="{StaticResource Pill}" HorizontalAlignment="Left"><TextBlock x:Name="t" Text="{Binding KindText}" FontSize="11.5"/></Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsOfficial}" Value="True">
                                                        <Setter TargetName="b" Property="Style" Value="{StaticResource GoldPill}"/>
                                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource GoldText}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="100">
                                        <GridViewColumn.Header><TextBlock Text="{kit:T upd.col.official}"/></GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding OfficialText}"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="135">
                                        <GridViewColumn.Header><TextBlock Text="{kit:T upd.col.date}"/></GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DateText}"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="200">
                                        <GridViewColumn.Header><TextBlock Text="{kit:T upd.col.title}"/></GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="90">
                                        <GridViewColumn.Header><TextBlock Text="{kit:T upd.col.size}"/></GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="80">
                                        <GridViewColumn.Header><TextBlock Text="{kit:T upd.col.devices}"/></GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Downloads}"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="110">
                                        <GridViewColumn.Header><TextBlock Text="{kit:T upd.col.state}"/></GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="s" Text="{Binding StateText}" Foreground="{StaticResource OkBrush}" TextTrimming="CharacterEllipsis"/>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="False"><Setter TargetName="s" Property="Foreground" Value="{StaticResource ErrBrush}"/></DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" x:Name="DetailTitle" Text="{kit:T upd.detail}" Style="{StaticResource CardHead}"/>
                            <TextBlock DockPanel.Dock="Top" x:Name="DetailNotes" FontSize="12.5" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <ListBox x:Name="DetailFiles" Style="{StaticResource LogList}" ItemContainerStyle="{StaticResource LogItem}" FontSize="11.5"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================= stats ======================= -->
            <TabItem Header="{kit:T upd.tab.stats}" x:Name="TabStats">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="4" Margin="0,0,-12,12">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="{kit:T upd.st.ok}" Style="{StaticResource StatK}"/><TextBlock x:Name="StOk" Style="{StaticResource StatV}" FontSize="24" kit:Bidi.Ltr="True"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="{kit:T upd.st.fail}" Style="{StaticResource StatK}"/><TextBlock x:Name="StFail" Style="{StaticResource StatV}" FontSize="24" kit:Bidi.Ltr="True"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="{kit:T upd.st.devices}" Style="{StaticResource StatK}"/><TextBlock x:Name="StDev" Style="{StaticResource StatV}" FontSize="24" kit:Bidi.Ltr="True"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="{kit:T upd.st.today}" Style="{StaticResource StatK}"/><TextBlock x:Name="StToday" Style="{StaticResource StatV}" FontSize="24" kit:Bidi.Ltr="True"/></StackPanel></Border>
                    </UniformGrid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <CheckBox DockPanel.Dock="Right" x:Name="ShowTests" Content="{kit:T upd.showTests}" Checked="ShowTests_Changed" Unchecked="ShowTests_Changed"/>
                                <TextBlock Text="{kit:T upd.chart}" Style="{StaticResource CardTitle}"/>
                            </DockPanel>
                            <!-- 14 day bars; drawn left-to-right like a time axis -->
                            <ItemsControl x:Name="Chart" Height="120" FlowDirection="LeftToRight">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="4,0" ToolTip="{Binding Tip}" Background="Transparent">
                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" FontSize="10.5" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            <Border VerticalAlignment="Bottom" Height="{Binding H}" CornerRadius="3,3,0,0" Background="{Binding Fill}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <ListView Grid.Row="2" x:Name="EventList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="170"><GridViewColumn.Header><TextBlock Text="{kit:T upd.col.time}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TimeText}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="100"><GridViewColumn.Header><TextBlock Text="{kit:T upd.col.event}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding KindText}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="80"><GridViewColumn.Header><TextBlock Text="{kit:T upd.col.version}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Version}" FontFamily="{StaticResource MonoFont}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="180"><GridViewColumn.Header><TextBlock Text="{kit:T upd.col.result}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ResultText}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="100"><GridViewColumn.Header><TextBlock Text="{kit:T upd.col.size}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding BytesText}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="120"><GridViewColumn.Header><TextBlock Text="IP"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding IpText}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="140"><GridViewColumn.Header><TextBlock Text="{kit:T upd.col.device}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DeviceText}" FontFamily="{StaticResource MonoFont}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- ======================= official ======================= -->
            <TabItem Header="{kit:T upd.tab.official}" x:Name="TabOfficial">
                <DockPanel Margin="0,14,0,0">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="GoMirror_Click" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE753;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T upd.goMirror}"/></StackPanel>
                            </Button>
                            <UniformGrid Columns="3">
                                <StackPanel><TextBlock Text="{kit:T upd.off.latest}" Style="{StaticResource StatK}"/><TextBlock x:Name="OffLatest" Style="{StaticResource StatV}" kit:Bidi.Ltr="True" Text="—"/></StackPanel>
                                <StackPanel><TextBlock Text="{kit:T upd.off.checked}" Style="{StaticResource StatK}"/><TextBlock x:Name="OffChecked" Style="{StaticResource StatV}" FontSize="14" kit:Bidi.Ltr="True" Text="—"/></StackPanel>
                                <StackPanel><TextBlock Text="{kit:T upd.off.source}" Style="{StaticResource StatK}"/><TextBlock x:Name="OffSource" Style="{StaticResource StatV}" FontSize="12" kit:Bidi.Ltr="True" TextWrapping="Wrap" Text="—"/></StackPanel>
                            </UniformGrid>
                        </DockPanel>
                    </Border>
                    <ListView x:Name="OfficialList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="110"><GridViewColumn.Header><TextBlock Text="{kit:T upd.col.official}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding OfficialText}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="110"><GridViewColumn.Header><TextBlock Text="{kit:T upd.col.ours}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding OursText}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="100"><GridViewColumn.Header><TextBlock Text="{kit:T upd.col.size}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="150"><GridViewColumn.Header><TextBlock Text="{kit:T upd.col.date}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CreatedText}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="110"><GridViewColumn.Header><TextBlock Text="{kit:T upd.col.state}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="420"><GridViewColumn.Header><TextBlock Text="{kit:T upd.col.source}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SourceUrl}" Style="{StaticResource LtrText}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource FaintBrush}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
