<Window x:Class="MobileStudio.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kit="clr-namespace:ScriptHazem.Kit"
        Title="{kit:T app.title}" Width="560" SizeToContent="Height" MaxHeight="700"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Icon="pack://application:,,,/Images/scripthazem.ico">
    <!-- margin leaves room for the soft popup shadow (no DropShadowEffect) -->
    <Grid x:Name="Root" Margin="12,8,12,16" FlowDirection="{Binding Flow, Source={x:Static kit:Loc.I}}">
        <ContentControl Template="{StaticResource SoftShadow}" Focusable="False"/>
        <Border CornerRadius="10" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
        <StackPanel Margin="24,22,24,20">
            <Grid MouseLeftButtonDown="Drag" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconTile}" VerticalAlignment="Top" Margin="0,0,14,0">
                    <TextBlock x:Name="Glyph" Text="&#xE897;" Style="{StaticResource TileGlyph}" FontSize="15"/>
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" Style="{StaticResource CardTitle}" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
            <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" Margin="50,10,0,0">
                <StackPanel>
                    <TextBox x:Name="MessageText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource SubtleBrush}"/>
                    <!-- "what will happen" steps -->
                    <ItemsControl x:Name="StepList" Margin="0,10,0,0" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource Kbd}" VerticalAlignment="Top" Margin="0,1,10,0" MinWidth="20">
                                        <TextBlock Text="{Binding N}" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource SubtleBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Foreground="{StaticResource TextBrush}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="NoteBox" Style="{StaticResource WarnBanner}" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="NoteText" TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{StaticResource TextBrush}"/>
                    </Border>
                    <!-- optional "type the word to confirm" -->
                    <StackPanel x:Name="TypePanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TypeLabel" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TypeBox" Style="{StaticResource LtrField}" TextChanged="TypeBox_Changed"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <DockPanel Margin="0,22,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource QuietButton}" Padding="8,4" Click="Copy_Click" ToolTip="{kit:T copy.dlgTip}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T copy.btn}" FontSize="12"/></StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="{kit:T dlg.cancel}" MinWidth="96" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
                <Button x:Name="OkButton" Style="{StaticResource GoldButton}" Content="{kit:T dlg.ok}" MinWidth="104" Padding="16,6" Click="Ok_Click"/>
            </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
