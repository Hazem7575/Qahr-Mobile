<UserControl x:Class="MobileStudio.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="clr-namespace:ScriptHazem.Kit"
             xmlns:core="clr-namespace:MobileStudio.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- quick launch: the 3 main mobile tools -->
                    <ItemsControl x:Name="QuickTools" VerticalAlignment="Center" Margin="0,0,8,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Tag="{Binding}" Click="Quick_Click" ToolTip="{Binding Desc}" IsEnabled="{Binding Exists}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource BtnGlyph}"/>
                                        <TextBlock Text="{Binding Name}" FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource GhostButton}" Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T common.refresh}"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{kit:T dash.title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{kit:T dash.sub}" Style="{StaticResource PageSub}"/>
                </StackPanel>
            </DockPanel>

            <!-- services -->
            <ItemsControl x:Name="Services" Grid.Row="1" Margin="0,0,-12,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Center" Padding="9,3,10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Margin="0,1,8,0" VerticalAlignment="Center" Fill="{Binding Dot}"/>
                                        <TextBlock Text="{Binding State}" FontSize="12" FontWeight="Medium" Foreground="{Binding Dot}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource IconTile}">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource TileGlyph}"/>
                                </Border>
                                <StackPanel Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- key numbers -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,18" Cursor="Hand" MouseLeftButtonUp="Players_Click">
                    <StackPanel>
                        <TextBlock Text="{kit:T dash.online}" Style="{StaticResource StatK}"/>
                        <TextBlock x:Name="OnlineText" Text="—" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource HeadingBrush}" kit:Bidi.Ltr="True"/>
                        <TextBlock x:Name="OnlineSub" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,18">
                    <UniformGrid Columns="2" Rows="2">
                        <StackPanel Margin="0,0,8,14"><TextBlock Text="{kit:T dash.uptime}" Style="{StaticResource StatK}"/><TextBlock x:Name="UptimeText" Text="—" Style="{StaticResource StatV}" FontSize="14" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel Margin="0,0,8,14"><TextBlock Text="{kit:T dash.ram}" Style="{StaticResource StatK}"/><TextBlock x:Name="RamText" Text="—" Style="{StaticResource StatV}" kit:Bidi.Ltr="True"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="{kit:T dash.tick}" Style="{StaticResource StatK}"/><TextBlock x:Name="TickText" Text="—" Style="{StaticResource StatV}" kit:Bidi.Ltr="True"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="{kit:T dash.db}" Style="{StaticResource StatK}"/><TextBlock x:Name="DbText" Text="—" Style="{StaticResource StatV}" kit:Bidi.Ltr="True"/></StackPanel>
                    </UniformGrid>
                </Border>
                <Border Grid.Column="2" x:Name="HrCard" Style="{StaticResource Card}" Padding="20,18">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Border x:Name="HrPill" DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Center" Padding="9,3,10,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="HrDot" Width="7" Height="7" Margin="0,1,8,0" VerticalAlignment="Center" Fill="{StaticResource FaintBrush}"/>
                                    <TextBlock x:Name="HrState" FontSize="12" FontWeight="Medium"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{kit:T dash.hr}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="HrMode" FontSize="12.5" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,10,0,0" DockPanel.Dock="Top"/>
                        <TextBlock x:Name="HrFile" Style="{StaticResource LtrText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,8,0,0" DockPanel.Dock="Top"/>
                        <TextBlock x:Name="HrLine" Style="{StaticResource LtrText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource SubtleBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" MinHeight="260">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Click="Logs_Click" Padding="8,3">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE756;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T dash.openLogs}" FontSize="12"/></StackPanel>
                            </Button>
                            <core:CopyAllButton Target="{Binding ElementName=ErrorList}" DockPanel.Dock="Right"/>
                            <TextBlock Text="{kit:T dash.errors}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid>
                            <ListBox x:Name="ErrorList" Style="{StaticResource LogList}" ItemContainerStyle="{StaticResource LogItem}" MaxHeight="300">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Source}" Foreground="{StaticResource FaintBrush}" Width="92"/>
                                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="NoErrors" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border Style="{StaticResource IconTile}" Width="44" Height="44" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource TileGlyph}" Foreground="{StaticResource OkBrush}"/>
                                </Border>
                                <TextBlock Text="{kit:T dash.noErrors}" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="{kit:T dash.noErrorsHint}" Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{kit:T dash.versions}" Style="{StaticResource CardHead}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{kit:T dash.published}" Style="{StaticResource StatK}"/><TextBlock x:Name="PublishedText" Text="—" Style="{StaticResource StatV}" kit:Bidi.Ltr="True"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="{kit:T dash.official}" Style="{StaticResource StatK}"/><TextBlock x:Name="OfficialText" Text="—" Style="{StaticResource StatV}" kit:Bidi.Ltr="True"/></StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="{kit:T dash.devices}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="VersionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Version}" FontFamily="{StaticResource MonoFont}" kit:Bidi.Ltr="True" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{StaticResource Panel2Brush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Border HorizontalAlignment="Left" CornerRadius="4" Background="{Binding Bar}" Width="{Binding BarWidth}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="12" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="VersionHint" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
