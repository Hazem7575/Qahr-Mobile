<UserControl x:Class="MobileStudio.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="clr-namespace:ScriptHazem.Kit">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource GhostButton}" Click="Open_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T set.openData}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource GoldButton}" Click="Save_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource GoldGlyph}"/><TextBlock Text="{kit:T set.save}"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{kit:T set.title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{kit:T set.sub}" Style="{StaticResource PageSub}"/>
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource SpacedCard}">
                        <StackPanel x:Name="PathPanel">
                            <TextBlock Text="{kit:T set.paths}" Style="{StaticResource CardHead}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource SpacedCard}">
                        <StackPanel>
                            <TextBlock Text="{kit:T set.config}" Style="{StaticResource CardHead}"/>
                            <ItemsControl x:Name="ConfigList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource LtrText}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                                <TextBlock Text="{Binding Key}" FontSize="12" Foreground="{StaticResource FaintBrush}"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{kit:T set.noSecrets}" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SpacedCard}">
                        <StackPanel>
                            <TextBlock Text="{kit:T set.git}" Style="{StaticResource CardHead}"/>
                            <TextBlock Text="{kit:T set.gitName}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="GitName" Style="{StaticResource LtrField}"/>
                            <TextBlock Text="{kit:T set.gitEmail}" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/>
                            <TextBox x:Name="GitEmail" Style="{StaticResource LtrField}"/>
                            <TextBlock Text="{kit:T set.exDirs}" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/>
                            <TextBox x:Name="ExDirs" Style="{StaticResource LtrField}" TextWrapping="Wrap"/>
                            <TextBlock Text="{kit:T set.exFiles}" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/>
                            <TextBox x:Name="ExFiles" Style="{StaticResource LtrField}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{kit:T set.backup}" Style="{StaticResource CardHead}"/>
                            <TextBlock Text="{kit:T set.keep}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="KeepBox" Style="{StaticResource LtrField}" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="{kit:T set.logs}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                            <TextBlock x:Name="AppData" Style="{StaticResource LtrText}" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
