<UserControl x:Class="MobileStudio.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="clr-namespace:ScriptHazem.Kit"
             xmlns:core="clr-namespace:MobileStudio.Core">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{kit:T logs.title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{kit:T logs.sub}" Style="{StaticResource PageSub}"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" x:Name="SourcePanel" Margin="0,0,0,10">
            <RadioButton Style="{StaticResource ChipToggle}" GroupName="src" Tag="watch" Content="watch.log" IsChecked="True" Margin="0,0,6,6" Checked="Source_Checked"/>
            <RadioButton Style="{StaticResource ChipToggle}" GroupName="src" Tag="watcherr" Content="watch.err.log" Margin="0,0,6,6" Checked="Source_Checked"/>
            <RadioButton Style="{StaticResource ChipToggle}" GroupName="src" Tag="acc" Content="acc.log" Margin="0,0,6,6" Checked="Source_Checked"/>
            <RadioButton Style="{StaticResource ChipToggle}" GroupName="src" Tag="accerr" Content="acc.err.log" Margin="0,0,6,6" Checked="Source_Checked"/>
            <RadioButton Style="{StaticResource ChipToggle}" GroupName="src" Tag="packets" Content="PacketLogs" Margin="0,0,6,6" Checked="Source_Checked"/>
            <RadioButton Style="{StaticResource ChipToggle}" GroupName="src" Tag="cdn" Content="cdn_access.log" Margin="0,0,6,6" Checked="Source_Checked"/>
            <RadioButton Style="{StaticResource ChipToggle}" GroupName="src" Tag="cdnerr" Content="cdn_serve.err.log" Margin="0,0,6,6" Checked="Source_Checked"/>
            <RadioButton Style="{StaticResource ChipToggle}" GroupName="src" Tag="adminapi" Content="adminapi_log.txt" Margin="0,0,6,6" Checked="Source_Checked"/>
            <RadioButton Style="{StaticResource ChipToggle}" GroupName="src" Tag="actions" Content="{kit:T logs.actions}" Margin="0,0,6,6" Checked="Source_Checked"/>
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <core:CopyAllButton Target="{Binding ElementName=LogBox}" Margin="0,0,6,0"/>
                    <ToggleButton x:Name="AutoBtn" Style="{StaticResource ChipCheck}" IsChecked="True" Margin="0,0,6,0" Content="{kit:T logs.auto}" ToolTip="{kit:T logs.autoTip}"/>
                    <Button Style="{StaticResource QuietButton}" Click="Copy_Click" Padding="8,4" ToolTip="{kit:T logs.copyTip}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T logs.copy}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuietButton}" Click="Open_Click" Padding="8,4">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T logs.open}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuietButton}" Click="Reload_Click" Padding="8,4">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T logs.reload}"/></StackPanel>
                    </Button>
                </StackPanel>
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="{kit:T logs.search}" Width="320" TextChanged="Search_Changed"/>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <RadioButton x:Name="LvAll" Style="{StaticResource ChipToggle}" GroupName="lv" Content="{kit:T logs.lv.all}" IsChecked="True" Margin="0,0,6,0" Checked="Level_Checked"/>
                    <RadioButton x:Name="LvWarn" Style="{StaticResource ChipToggle}" GroupName="lv" Content="{kit:T logs.lv.warn}" Margin="0,0,6,0" Checked="Level_Checked"/>
                    <RadioButton x:Name="LvErr" Style="{StaticResource ChipToggle}" GroupName="lv" Content="{kit:T logs.lv.err}" Checked="Level_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ListBox Grid.Row="3" x:Name="LogBox" Style="{StaticResource LogList}" ItemContainerStyle="{StaticResource LogItem}">
            <ListBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"/></DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="4" Margin="2,8,0,0">
            <TextBlock DockPanel.Dock="Right" x:Name="CountText" Style="{StaticResource Hint}"/>
            <TextBlock x:Name="PathText" Style="{StaticResource LtrText}" FontSize="11.5" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</UserControl>
