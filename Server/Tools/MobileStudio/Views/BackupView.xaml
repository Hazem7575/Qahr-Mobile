<UserControl x:Class="MobileStudio.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="clr-namespace:ScriptHazem.Kit">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource GhostButton}" Click="OpenFolder_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T bk.openFolder}"/></StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{kit:T bk.title}" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="SubText" Style="{StaticResource PageSub}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource SpacedCard}">
                        <StackPanel>
                            <TextBlock Text="{kit:T bk.newTitle}" Style="{StaticResource CardHead}"/>
                            <CheckBox x:Name="DbBox" IsChecked="True" Content="{kit:T bk.db}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DbHint" Style="{StaticResource Hint}" Margin="26,0,0,10"/>
                            <CheckBox x:Name="DataBox" IsChecked="True" Content="{kit:T bk.data}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DataHint" Style="{StaticResource Hint}" Margin="26,0,0,10"/>
                            <CheckBox x:Name="PatchesBox" Content="{kit:T bk.patches}" Margin="0,0,0,12" Checked="Patches_Changed" Unchecked="Patches_Changed"/>
                            <TextBlock Text="{kit:T bk.note}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NoteBox" Style="{StaticResource FieldBox}" Tag="{kit:T bk.notePh}"/>
                            <Button x:Name="BackupBtn" Style="{StaticResource GoldButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Backup_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource GoldGlyph}"/><TextBlock Text="{kit:T bk.now}"/></StackPanel>
                            </Button>
                            <ProgressBar x:Name="Busy" Height="3" Margin="0,12,0,0" IsIndeterminate="False" Visibility="Collapsed"/>
                            <TextBlock x:Name="StepText" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{kit:T bk.restoreTitle}" Style="{StaticResource CardHead}"/>
                            <TextBlock x:Name="SelText" Text="{kit:T bk.pick}" FontSize="12.5" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button x:Name="VerifyBtn" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="Verify_Click" ToolTip="{kit:T bk.verifyTip}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T bk.verify}"/></StackPanel>
                            </Button>
                            <TextBlock x:Name="VerifyText" Style="{StaticResource Hint}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <TextBlock Text="{kit:T bk.dbTarget}" Style="{StaticResource FieldLabel}"/>
                            <RadioButton x:Name="DbLive" Style="{StaticResource ChipToggle}" HorizontalAlignment="Left" GroupName="dbt" Content="{kit:T bk.dbLive}" Margin="0,0,0,6"/>
                            <RadioButton x:Name="DbCopy" Style="{StaticResource ChipToggle}" HorizontalAlignment="Left" GroupName="dbt" Content="{kit:T bk.dbCopy}" IsChecked="True" Margin="0,0,0,4" ToolTip="{kit:T bk.dbCopyTip}"/>
                            <TextBox x:Name="CopyName" Style="{StaticResource LtrField}" Margin="26,2,0,8" Text="qahr_mobile_restorecheck"/>
                            <Button x:Name="RestoreDbBtn" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="RestoreDb_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T bk.restoreDb}"/></StackPanel>
                            </Button>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14"/>
                            <TextBlock Text="{kit:T bk.dataTarget}" Style="{StaticResource FieldLabel}"/>
                            <RadioButton x:Name="DataLive" Style="{StaticResource ChipToggle}" HorizontalAlignment="Left" GroupName="dt" Content="{kit:T bk.dataLive}" Margin="0,0,0,6"/>
                            <RadioButton x:Name="DataOther" Style="{StaticResource ChipToggle}" HorizontalAlignment="Left" GroupName="dt" Content="{kit:T bk.dataOther}" IsChecked="True" Margin="0,0,0,6"/>
                            <DockPanel Margin="26,2,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE838;" Margin="8,0,0,0" Click="PickTarget_Click"/>
                                <TextBox x:Name="OtherPath" Style="{StaticResource LtrField}"/>
                            </DockPanel>
                            <Button x:Name="RestoreDataBtn" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="RestoreData_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T bk.restoreData}"/></StackPanel>
                            </Button>
                            <TextBlock Text="{kit:T bk.restoreHint}" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>
                <Grid>
                    <ListView x:Name="List" SelectionChanged="List_Selected">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="160"><GridViewColumn.Header><TextBlock Text="{kit:T bk.col.date}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CreatedText}" Style="{StaticResource LtrText}" FontWeight="Medium"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="110"><GridViewColumn.Header><TextBlock Text="{kit:T bk.col.kind}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding KindText}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="200"><GridViewColumn.Header><TextBlock Text="{kit:T bk.col.content}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ContentText}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="90"><GridViewColumn.Header><TextBlock Text="{kit:T bk.col.size}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource LtrText}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="300"><GridViewColumn.Header><TextBlock Text="{kit:T bk.col.note}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Note}" Foreground="{StaticResource SubtleBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border Style="{StaticResource IconTile}" Width="48" Height="48" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource TileGlyph}"/>
                        </Border>
                        <TextBlock Text="{kit:T bk.empty}" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="{kit:T bk.emptyHint}" Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <ListBox Grid.Row="2" x:Name="Entries" Style="{StaticResource LogList}" ItemContainerStyle="{StaticResource LogItem}" FontSize="11.5"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
