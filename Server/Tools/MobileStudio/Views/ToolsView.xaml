<UserControl x:Class="MobileStudio.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="clr-namespace:ScriptHazem.Kit"
             xmlns:core="clr-namespace:MobileStudio.Core">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource GhostButton}" Click="Home_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T tools.home}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T common.refresh}"/></StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{kit:T tools.title}" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="SubText" Style="{StaticResource PageSub}"/>
            </StackPanel>
        </DockPanel>

        <!-- tool cards -->
        <ItemsControl x:Name="Cards" Grid.Row="1" Margin="0,0,-12,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <Border Style="{StaticResource IconTile}" Width="40" Height="40" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource TileGlyph}" FontSize="18"/>
                                </Border>
                                <StackPanel Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="14.5" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Updated}" Style="{StaticResource Hint}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Center" Padding="9,3,10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Margin="0,1,8,0" VerticalAlignment="Center" Fill="{Binding StateBrush}"/>
                                        <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="Medium" Foreground="{Binding StateBrush}"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Click="Open_Click" Tag="{Binding}" IsEnabled="{Binding Exists}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T tools.open}"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuietButton}" Margin="8,0,0,0" Padding="8,4" Click="Folder_Click" Tag="{Binding}" ToolTip="{kit:T tools.folderTip}">
                                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource IconBrush}"/>
                                </Button>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding PathText}" Style="{StaticResource LtrText}" FontSize="11" Foreground="{StaticResource FaintBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,10,0,0" ToolTip="{Binding PathText}"/>
                            <TextBlock Text="{Binding Desc}" FontSize="12.5" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="19"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- client source + engine -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource SpacedCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}" Margin="0,0,12,0"><TextBlock Text="&#xE943;" Style="{StaticResource TileGlyph}"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{kit:T tools.client}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="ClientPath" Style="{StaticResource LtrText}" FontSize="11" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{kit:T tools.clientDesc}" FontSize="12.5" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,10,0,10" LineHeight="19"/>
                            <WrapPanel>
                                <Button Style="{StaticResource QuietButton}" Margin="0,0,6,6" Padding="8,4" Click="ClientFolder_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T tools.folder}" FontSize="12"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuietButton}" Margin="0,0,6,6" Padding="8,4" Click="ClientReadme_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="README_AR.md" FontSize="12"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuietButton}" Margin="0,0,6,6" Padding="8,4" Click="ClientOut_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="out" FontSize="12"/></StackPanel>
                                </Button>
                            </WrapPanel>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,8,0,12"/>
                            <WrapPanel>
                                <Button x:Name="CheckBtn" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="ClientCheck_Click" ToolTip="{kit:T tools.checkTip}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T tools.check}"/></StackPanel>
                                </Button>
                                <Button x:Name="BuildBtn" Style="{StaticResource GoldButton}" Margin="0,0,8,8" Click="ClientBuild_Click" ToolTip="{kit:T tools.buildTip}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" Style="{StaticResource GoldGlyph}"/><TextBlock Text="{kit:T tools.build}"/></StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock Text="{kit:T tools.patchZip}" Style="{StaticResource FieldLabel}" Margin="0,4,0,6"/>
                            <DockPanel>
                                <Button x:Name="ZipBtn" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ClientZip_Click" ToolTip="{kit:T tools.zipTip}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T tools.zip}"/></StackPanel>
                                </Button>
                                <TextBox x:Name="ZipVersion" Style="{StaticResource LtrField}" Tag="5172"/>
                            </DockPanel>
                            <TextBlock x:Name="ZipHint" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}" Margin="0,0,12,0"><TextBlock Text="&#xE950;" Style="{StaticResource TileGlyph}"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{kit:T tools.engine}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="EnginePath" Style="{StaticResource LtrText}" FontSize="11" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{kit:T tools.engineDesc}" FontSize="12.5" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,10,0,10" LineHeight="19"/>
                            <WrapPanel>
                                <Button Style="{StaticResource QuietButton}" Margin="0,0,6,6" Padding="8,4" Click="EngineFolder_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T tools.folder}" FontSize="12"/></StackPanel>
                                </Button>
                                <Button x:Name="EngineReadmeBtn" Style="{StaticResource QuietButton}" Margin="0,0,6,6" Padding="8,4" Click="EngineReadme_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="README_AR.md" FontSize="12"/></StackPanel>
                                </Button>
                                <Button x:Name="GhidraBtn" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Click="Ghidra_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T tools.ghidra}"/></StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock x:Name="GhidraHint" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <DockPanel Grid.Column="2">
                <Border x:Name="Banner" DockPanel.Dock="Top" Style="{StaticResource InfoBanner}" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock x:Name="BannerGlyph" Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource InfoBrush}" Margin="0,1,10,0"/>
                        <Button DockPanel.Dock="Right" x:Name="CancelBtn" Style="{StaticResource IconButton}" MinWidth="30" Margin="8,-4,0,-4" Click="Cancel_Click" IsEnabled="False"
                                ToolTip="{kit:T build.cancelTip}" Content="&#xE711;" Foreground="{StaticResource ErrBrush}"/>
                        <TextBlock x:Name="BannerText" FontSize="12.5" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                    <core:CopyAllButton DockPanel.Dock="Right" Target="{Binding ElementName=OutputBox}"/>
                    <TextBlock Text="{kit:T tools.console}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="OutputBox" Style="{StaticResource MonoArea}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
