<UserControl x:Class="MobileStudio.Views.PlayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="clr-namespace:ScriptHazem.Kit"
             xmlns:core="clr-namespace:MobileStudio.Core">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource GhostButton}" Click="Refresh_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T common.refresh}"/></StackPanel>
                </Button>
                <Button x:Name="SaveAllBtn" Style="{StaticResource GhostButton}" Click="SaveAll_Click" ToolTip="{kit:T srv.saveTip}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T srv.save}"/></StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{kit:T pl.title}" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="SubText" Text="{kit:T pl.sub}" Style="{StaticResource PageSub}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Right" x:Name="CountText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="{kit:T pl.search}" TextChanged="Search_Changed" MaxWidth="360" HorizontalAlignment="Left"/>
                </DockPanel>
                <Grid Grid.Row="1">
                    <ListView x:Name="PlayerList" SelectionChanged="Player_Selected">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="170"><GridViewColumn.Header><TextBlock Text="{kit:T pl.col.name}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <Border Style="{StaticResource GoldPill}" Margin="6,0,0,0" Padding="5,0,5,1" Visibility="{Binding GmVis}"><TextBlock Text="GM" FontSize="10.5" Foreground="{StaticResource GoldText}"/></Border>
                                            <Border Style="{StaticResource Pill}" Margin="6,0,0,0" Padding="5,0,5,1" Visibility="{Binding BotVis}"><TextBlock Text="BOT" FontSize="10.5" Foreground="{StaticResource FaintBrush}"/></Border>
                                        </StackPanel>
                                    </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="90"><GridViewColumn.Header><TextBlock Text="UID"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Uid}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource SubtleBrush}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="70"><GridViewColumn.Header><TextBlock Text="{kit:T pl.col.level}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding LevelText}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="70"><GridViewColumn.Header><TextBlock Text="{kit:T pl.col.class}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Cls}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="150"><GridViewColumn.Header><TextBlock Text="{kit:T pl.col.where}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Where}" FontFamily="{StaticResource MonoFont}" Style="{StaticResource LtrText}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="60"><GridViewColumn.Header><TextBlock Text="VIP"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Vip}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="110"><GridViewColumn.Header><TextBlock Text="{kit:T pl.col.hp}"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Hp}" Style="{StaticResource LtrText}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                <GridViewColumn Width="80"><GridViewColumn.Header><TextBlock Text="BP"/></GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Bp}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border Style="{StaticResource IconTile}" Width="48" Height="48" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE716;" Style="{StaticResource TileGlyph}"/>
                        </Border>
                        <TextBlock x:Name="EmptyTitle" Text="{kit:T pl.empty}" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock x:Name="EmptyHint" Text="{kit:T pl.emptyHint}" Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <!-- reply log -->
                <DockPanel Grid.Row="2" Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6"><core:CopyAllButton Target="{Binding ElementName=ReplyBox}" DockPanel.Dock="Right"/><TextBlock Text="{kit:T pl.replies}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel>
                    <TextBox x:Name="ReplyBox" Style="{StaticResource MonoArea}" Height="130" IsReadOnly="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                </DockPanel>
            </Grid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- selected player -->
                    <Border Style="{StaticResource SpacedCard}">
                        <StackPanel>
                            <TextBlock x:Name="SelTitle" Text="{kit:T pl.noSel}" Style="{StaticResource CardHead}"/>
                            <TextBlock Text="{kit:T pl.msg}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="MsgBox" Style="{StaticResource FieldBox}" Tag="{kit:T pl.msgPh}" MaxLength="250"/>
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" x:Name="MsgBtn" Style="{StaticResource GhostButton}" Click="Msg_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE724;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T pl.send}"/></StackPanel>
                                </Button>
                                <CheckBox x:Name="PopupBox" Content="{kit:T pl.popup}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14"/>
                            <TextBlock Text="{kit:T pl.kickReason}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="KickBox" Style="{StaticResource FieldBox}" Tag="{kit:T pl.kickPh}" MaxLength="120"/>
                            <Button x:Name="KickBtn" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Kick_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,1,8,0" FontSize="12"/><TextBlock Text="{kit:T pl.kick}"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <!-- broadcast -->
                    <Border Style="{StaticResource SpacedCard}">
                        <StackPanel>
                            <TextBlock Text="{kit:T pl.bcTitle}" Style="{StaticResource CardHead}"/>
                            <TextBox x:Name="BcBox" Style="{StaticResource FieldBox}" Tag="{kit:T pl.bcPh}" MaxLength="250"/>
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" x:Name="BcBtn" Style="{StaticResource GhostButton}" Click="Broadcast_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE789;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T pl.bcSend}"/></StackPanel>
                                </Button>
                                <ComboBox x:Name="BcMode" Width="150" HorizontalAlignment="Left" SelectedIndex="0">
                                    <ComboBoxItem Tag="center" Content="{kit:T pl.bc.center}"/>
                                    <ComboBoxItem Tag="broadcast" Content="{kit:T pl.bc.broadcast}"/>
                                    <ComboBoxItem Tag="system" Content="{kit:T pl.bc.system}"/>
                                    <ComboBoxItem Tag="talk" Content="{kit:T pl.bc.talk}"/>
                                </ComboBox>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <!-- reloads -->
                    <Border Style="{StaticResource SpacedCard}">
                        <StackPanel>
                            <TextBlock Text="{kit:T pl.reloadTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{kit:T pl.reloadHint}" Style="{StaticResource Hint}" Margin="0,2,0,10"/>
                            <WrapPanel x:Name="ReloadPanel">
                                <Button Style="{StaticResource SmallButton}" Margin="0,0,6,6" Tag="reloadnpcs" Content="NPCs" Click="Reload_Click"/>
                                <Button Style="{StaticResource SmallButton}" Margin="0,0,6,6" Tag="reloadquests" Content="{kit:T pl.rl.quests}" Click="Reload_Click"/>
                                <Button Style="{StaticResource SmallButton}" Margin="0,0,6,6" Tag="reloadmonsters" Content="{kit:T pl.rl.monsters}" Click="Reload_Click"/>
                                <Button Style="{StaticResource SmallButton}" Margin="0,0,6,6" Tag="reloaditems" Content="{kit:T pl.rl.items}" Click="Reload_Click"/>
                                <Button Style="{StaticResource SmallButton}" Margin="0,0,6,6" Tag="reloadshops" Content="{kit:T pl.rl.shops}" Click="Reload_Click"/>
                                <Button Style="{StaticResource SmallButton}" Margin="0,0,6,6" Tag="reloadportals" Content="{kit:T pl.rl.portals}" Click="Reload_Click"/>
                                <Button Style="{StaticResource SmallButton}" Margin="0,0,6,6" Tag="reloaddrops" Content="{kit:T pl.rl.drops}" Click="Reload_Click"/>
                                <Button Style="{StaticResource SmallButton}" Margin="0,0,6,6" Tag="reloadrates" Content="{kit:T pl.rl.rates}" Click="Reload_Click"/>
                                <Button Style="{StaticResource SmallButton}" Margin="0,0,6,6" Tag="reloadall" Content="{kit:T pl.rl.all}" Click="Reload_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <!-- GM command -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{kit:T pl.gmTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{kit:T pl.gmHint}" Style="{StaticResource Hint}" Margin="0,2,0,10"/>
                            <TextBlock Text="{kit:T pl.gmAs}" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="8,0,0,0" Click="Gms_Click" ToolTip="{kit:T pl.gmsRefresh}"/>
                                <ComboBox x:Name="GmBox" DisplayMemberPath="Label"/>
                            </DockPanel>
                            <TextBlock Text="{kit:T pl.gmCmd}" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/>
                            <TextBox x:Name="CmdBox" Style="{StaticResource LtrField}" FontFamily="{StaticResource MonoFont}" Tag="@item 410339 1" KeyDown="Cmd_KeyDown"/>
                            <Button x:Name="CmdBtn" Style="{StaticResource GoldButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Cmd_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource GoldGlyph}"/><TextBlock Text="{kit:T pl.run}"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
