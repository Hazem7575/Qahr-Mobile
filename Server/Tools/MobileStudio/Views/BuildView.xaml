<UserControl x:Class="MobileStudio.Views.BuildView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="clr-namespace:ScriptHazem.Kit"
             xmlns:core="clr-namespace:MobileStudio.Core">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{kit:T build.title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{kit:T build.sub}" Style="{StaticResource PageSub}"/>
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1">
            <!-- ======================= servers ======================= -->
            <TabItem Header="{kit:T build.tab.server}" x:Name="TabServer">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="CheckBtn" Style="{StaticResource GoldButton}" Click="Check_Click" ToolTip="{kit:T build.checkTip}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" Style="{StaticResource GoldGlyph}"/><TextBlock Text="{kit:T build.check}"/></StackPanel>
                                </Button>
                                <Button x:Name="LiveBtn" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Live_Click" ToolTip="{kit:T build.liveTip}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T build.live}"/></StackPanel>
                                </Button>
                                <Button x:Name="CancelBtn" Style="{StaticResource IconButton}" MinWidth="34" Margin="8,0,0,0" Click="Cancel_Click" IsEnabled="False"
                                        ToolTip="{kit:T build.cancelTip}" Content="&#xE711;" Foreground="{StaticResource ErrBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{kit:T build.target}" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <RadioButton x:Name="TgtGame" Style="{StaticResource ChipToggle}" GroupName="tgt" Content="GameServer" IsChecked="True" Margin="0,0,6,0" Checked="Tgt_Changed"/>
                                <RadioButton x:Name="TgtAcc" Style="{StaticResource ChipToggle}" GroupName="tgt" Content="AccServer" Checked="Tgt_Changed"/>
                                <TextBlock x:Name="TgtHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="420"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" x:Name="ResultBanner" Style="{StaticResource InfoBanner}" Margin="0,0,0,12">
                        <DockPanel>
                            <TextBlock x:Name="ResultGlyph" Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource InfoBrush}" VerticalAlignment="Center" Margin="0,1,10,0"/>
                            <TextBlock x:Name="ResultText" Text="{kit:T build.ready}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" x:Name="IssuesTitle" Text="{kit:T build.issues}" Margin="2,0,0,8"/>
                        <ListView x:Name="IssueList" MouseDoubleClick="Issue_DoubleClick" ToolTip="{kit:T build.issueTip}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="84">
                                        <GridViewColumn.Header><TextBlock Text="{kit:T build.col.sev}"/></GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="dot" Width="6" Height="6" Fill="{StaticResource ErrBrush}" VerticalAlignment="Center" Margin="0,1,7,0"/>
                                                    <TextBlock Text="{Binding SeverityText}" x:Name="sev" Foreground="{StaticResource ErrBrush}" FontWeight="Medium"/>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                        <Setter TargetName="sev" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                        <Setter TargetName="dot" Property="Fill" Value="{StaticResource WarnBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="80">
                                        <GridViewColumn.Header><TextBlock Text="{kit:T build.col.code}"/></GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Code}" Style="{StaticResource LtrText}" FontFamily="{StaticResource MonoFont}"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="230">
                                        <GridViewColumn.Header><TextBlock Text="{kit:T build.col.where}"/></GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Where}" Style="{StaticResource LtrText}" Foreground="{StaticResource GoldText}" TextDecorations="Underline" Cursor="Hand" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="760">
                                        <GridViewColumn.Header><TextBlock Text="{kit:T build.col.msg}"/></GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Message}" Style="{StaticResource LtrText}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                    <DockPanel Grid.Row="4">
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8"><core:CopyAllButton Target="{Binding ElementName=OutputBox}" DockPanel.Dock="Right"/><TextBlock Style="{StaticResource SectionTitle}" Text="{kit:T build.output}" VerticalAlignment="Center"/></DockPanel>
                        <TextBox x:Name="OutputBox" Style="{StaticResource MonoArea}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ======================= APK ======================= -->
            <TabItem Header="{kit:T build.tab.apk}" x:Name="TabApk">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource SpacedCard}">
                                <StackPanel>
                                    <TextBlock Text="{kit:T apk.formTitle}" Style="{StaticResource CardHead}"/>
                                    <TextBlock Text="{kit:T apk.ip}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="IpBox" Style="{StaticResource LtrField}" Tag="26.31.69.47"/>
                                    <TextBlock Text="{kit:T apk.ipHint}" Style="{StaticResource Hint}" Margin="0,4,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{kit:T apk.port}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="PortBox" Style="{StaticResource LtrField}" Tag="16100"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{kit:T apk.regPort}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="RegBox" Style="{StaticResource LtrField}" Tag="9548"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{kit:T apk.patchHost}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                                    <TextBox x:Name="PatchHostBox" Style="{StaticResource LtrField}" Tag="26.31.69.47"/>
                                    <TextBlock Text="{kit:T apk.patchHostHint}" Style="{StaticResource Hint}" Margin="0,4,0,12"/>
                                    <TextBlock Text="{kit:T apk.cdn}" Style="{StaticResource FieldLabel}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Content="{kit:T apk.cdnOurs}" Click="CdnOurs_Click" ToolTip="{kit:T apk.cdnOursTip}"/>
                                        <TextBox x:Name="CdnBox" Style="{StaticResource LtrField}" Tag="http://IP:9550/ydzf/android/zf"/>
                                    </DockPanel>
                                    <TextBlock Text="{kit:T apk.cdnHint}" Style="{StaticResource Hint}" Margin="0,4,0,12"/>
                                    <CheckBox x:Name="SingleBox" Content="{kit:T apk.single}" IsChecked="True" Margin="0,0,0,4"/>
                                    <TextBlock Text="{kit:T apk.singleHint}" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                                    <TextBlock Text="{kit:T apk.out}" Style="{StaticResource FieldLabel}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE838;" Margin="8,0,0,0" Click="OutBrowse_Click" ToolTip="{kit:T common.browse}"/>
                                        <TextBox x:Name="OutBox" Style="{StaticResource LtrField}" Tag="build\"/>
                                    </DockPanel>
                                    <TextBlock Text="{kit:T apk.outHint}" Style="{StaticResource Hint}" Margin="0,4,0,14"/>
                                    <TextBlock x:Name="ApkCmd" Style="{StaticResource LtrText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource FaintBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ApkBtn" Style="{StaticResource GoldButton}" Click="Apk_Click">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" Style="{StaticResource GoldGlyph}"/><TextBlock Text="{kit:T apk.build}"/></StackPanel>
                                        </Button>
                                        <Button x:Name="ApkCancel" Style="{StaticResource IconButton}" MinWidth="34" Margin="8,0,0,0" Click="Cancel_Click" IsEnabled="False"
                                                ToolTip="{kit:T build.cancelTip}" Content="&#xE711;" Foreground="{StaticResource ErrBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{kit:T apk.installTitle}" Style="{StaticResource CardHead}"/>
                                    <TextBlock Text="{kit:T apk.device}" Style="{StaticResource FieldLabel}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="8,0,0,0" Click="Devices_Click" ToolTip="{kit:T apk.refreshDevices}"/>
                                        <ComboBox x:Name="DeviceBox" DisplayMemberPath="Label"/>
                                    </DockPanel>
                                    <TextBlock x:Name="DeviceHint" Style="{StaticResource Hint}" Margin="0,4,0,12"/>
                                    <TextBlock Text="{kit:T apk.file}" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="ApkFileText" Style="{StaticResource LtrText}" FontSize="12" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="InstallBtn" Style="{StaticResource GhostButton}" Click="Install_Click">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T apk.install}"/></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="OpenOut_Click">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" Style="{StaticResource BtnGlyph}"/><TextBlock Text="{kit:T apk.openOut}"/></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <DockPanel Grid.Column="2">
                        <Border x:Name="ApkBanner" DockPanel.Dock="Top" Style="{StaticResource InfoBanner}" Margin="0,0,0,12">
                            <DockPanel>
                                <TextBlock x:Name="ApkGlyph" Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource InfoBrush}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="ApkStatus" Text="{kit:T apk.ready}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="ApkProgress" Height="4" Margin="0,8,0,2" Minimum="0" Maximum="100" Visibility="Collapsed"
                                                 Foreground="{StaticResource GoldAccentBrush}" Background="{StaticResource Panel2Brush}" BorderThickness="0"/>
                                    <TextBlock x:Name="ApkOutPath" Style="{StaticResource LtrText}" FontSize="12" Foreground="{StaticResource GoldText}" Cursor="Hand"
                                               TextDecorations="Underline" MouseLeftButtonUp="ApkOutPath_Click" Visibility="Collapsed" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8"><core:CopyAllButton Target="{Binding ElementName=ApkOutput}" DockPanel.Dock="Right"/><TextBlock Style="{StaticResource SectionTitle}" Text="{kit:T build.output}" VerticalAlignment="Center"/></DockPanel>
                        <TextBox x:Name="ApkOutput" Style="{StaticResource MonoArea}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
